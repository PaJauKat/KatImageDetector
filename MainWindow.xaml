<Window x:Class="KatImageDetector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KatImageDetector"
        mc:Ignorable="d"
        Title="KatImageDetector" Height="1000" Width="1200" Background="#1E1E1E">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Detector de botones" FontSize="20" FontWeight="Bold" Foreground="#eeeeee"/>
            <TextBlock Text="Estado Actual:" Foreground="#AAAAAA"/>
            <TextBlock x:Name="lblEstado" Text="Detenido" FontWeight="Medium" Foreground="#FF5252"/>
        </StackPanel>

        
        <!-- Cuadro de Imagenes -->
        <Border Grid.Row="1" BorderBrush="#333333" BorderThickness="2" CornerRadius="5" Background="#2D2D2D">
            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="8" Background="#2D2D2D" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Padding="8"
                                MouseDown="Card_MouseDown">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!--Titulo-->
                                <TextBlock Text="{Binding Title}" Foreground="White" FontSize="14" Margin="0,0,0,6"/>
                                <!--Imagen-->
                                <Grid Grid.Row="1">
                                    <Image Source="{Binding CurrentImage.Image}" Stretch="Uniform" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="60000">
                                        <Image.ToolTip>
                                            <Border Background="#1E1E1E"  BorderBrush="#444" BorderThickness="2" Padding="10"  CornerRadius="6">
                                                <Image Source="{Binding CurrentImage.Image}" Width="800" Stretch="Uniform"/>
                                            </Border>
                                        </Image.ToolTip>
                                    </Image>
                                </Grid>
                                <!--Resultado-->
                                <TextBlock Grid.Row="2" Text="{Binding CurrentImage.Resultado}" Foreground="White" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center"/>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                
            </ItemsControl>
        </Border>

        <!-- Boton de Captura -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnIniciar" Content="Capturar" Width="100" Height="35"
                    Background="#3E3E42" Foreground="#CCCCCC"
                    FontWeight="Bold" Click="BtnOnOff_Click" BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="3"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
        
        
    </Grid>
</Window>
