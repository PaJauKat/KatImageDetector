<Window x:Class="KatImageDetector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KatImageDetector"
        mc:Ignorable="d"
        Title="KatImageDetector" Height="350" Width="450" Background="#1E1E1E">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Detector de botones" FontSize="20" FontWeight="Bold" Foreground="#eeeeee"/>
            <TextBlock Text="Estado Actual:" Foreground="#AAAAAA"/>
            <TextBlock x:Name="lblEstado" Text="Detenido" FontWeight="Medium" Foreground="#FF5252"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#333333" BorderThickness="2" CornerRadius="5" Background="#2D2D2D">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Image Grid.Row="0" x:Name="imgResultado" Stretch="Uniform" Margin="0,0,0,5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                <TextBlock Grid.Row="1" x:Name="coincidenceResult" Text="Result: --" Foreground="#EEEEEE" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,5"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnIniciar" Content="Capturar" Width="100" Height="35"
                    Background="#3E3E42" Foreground="#CCCCCC"
                    FontWeight="Bold" Click="BtnOnOff_Click" BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="3"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
